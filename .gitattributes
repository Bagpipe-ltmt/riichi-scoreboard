# 默认按文本处理，仓库里统一用 LF
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则 cmd.exe 可能解析出错
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 代码与文档统一 LF
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.xml   text eol=lf
*.ini   text eol=lf
*.example text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.ico   binary
*.exe   binary
